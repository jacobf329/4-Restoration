<Project Sdk="Godot.NET.Sdk/4.7.1">

  <PropertyGroup>
    <!-- Pinned to net8.0: the SDK on this machine is 8.0.423 (H:\dev-tools\dotnet). -->
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HitboxClone</RootNamespace>
  </PropertyGroup>

  <!--
    Stamp the build with the commit it was built from.

    This exists because "am I even running the new version?" was, for two machines and
    several rounds, genuinely unanswerable from inside the game - a clone that never
    pulled built and launched a months-old copy perfectly happily and said nothing. A
    version in the corner of the menu turns that from a debate into a glance.

    Written into the intermediate output rather than into src/, on purpose: a generated
    file inside the repository is a permanently dirty working tree, and Update.cmd
    refuses to update a dirty tree. Stamping the build would have stopped the updating.

    Everything here degrades to "unknown" rather than failing the build. git may not be
    installed, and the folder may not be a clone at all.
  -->
  <Target Name="StampBuild" BeforeTargets="BeforeCompile">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitHash" />
    </Exec>

    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; status --porcelain"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDirty" />
    </Exec>

    <PropertyGroup>
      <GitHash>$(GitHash.Trim())</GitHash>

      <!--
        Anything that is not a bare short hash is not one. git prints its errors on stderr, which
        ConsoleOutput does not capture, so a failure normally arrives here as an empty string -
        but "normally" is doing a lot of work on a machine nobody here can run, and a property
        with a space or a quote in it would be written straight into a C# string literal and turn
        a broken stamp into a broken build.
      -->
      <GitHash Condition="'$(GitHash)' == '' or $(GitHash.Contains(' ')) or $(GitHash.Contains('&quot;'))">unknown</GitHash>

      <!--
        Only trust this when the hash came back cleanly. ConsoleToMSBuild captures stderr as well
        as stdout, so a git that fails outright lands its complaint in GitDirty and would have the
        stamp claim uncommitted edits on a machine where git did not run at all.
      -->
      <LocalEdits>false</LocalEdits>
      <LocalEdits Condition="'$(GitDirty)' != '' and '$(GitHash)' != 'unknown'">true</LocalEdits>

      <!--
        The build date, from MSBuild rather than from git.

        This used to be the commit date, taken with a git log format string, and it broke every
        build on Windows while working perfectly here. MSBuild runs an Exec by writing it to a
        temporary .cmd file, so cmd.exe gets a pass over the command line first and eats the
        percent sequences: the date pattern reached git as "Y-d", which it rejects. Linux has no
        cmd.exe in that path, so the bug was invisible on the machine that wrote it.

        Escaping percent signs through both MSBuild and cmd is possible, and is a trap for
        whoever edits this next, so there are none at all now. The two remaining git calls,
        rev-parse and status, do not need any. The date comes from the framework instead.

        It means the stamp carries the date the build was made rather than the date the commit
        was made. That is a slightly different fact and, for the question this exists to answer,
        an equally good one: the hash is what identifies the version.
      -->
      <BuildStamp>$([System.DateTime]::Now.ToString('yyyy-MM-dd'))</BuildStamp>

      <StampFile>$(IntermediateOutputPath)BuildInfo.g.cs</StampFile>
    </PropertyGroup>

    <WriteLinesToFile File="$(StampFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by the StampBuild target. Do not edit and do not commit.;namespace HitboxClone%3B;public static class BuildInfo;{;    public const string Commit = &quot;$(GitHash)&quot;%3B;    public const string Date = &quot;$(BuildStamp)&quot;%3B;    public const bool LocalEdits = $(LocalEdits)%3B;}" />

    <ItemGroup>
      <Compile Include="$(StampFile)" />
    </ItemGroup>
  </Target>

</Project>
